---
import '../styles/global.css';
import Search from '../components/Search.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  /** Include this page in the search index. Defaults to concept, topic and domain pages only. */
  indexed?: boolean;
}
const { title, description } = Astro.props;
// Track pages, the home page and the domain list each repeat ~2,000 concepts, so they stay out of search.
const path = Astro.url.pathname.replace(/\/$/, '');
const indexed = Astro.props.indexed ?? (/^\/(t|topics)\/[^/]+$/.test(path) || /^\/domains\/[^/]+$/.test(path));
const pageTitle = title ? `${title} · Glosarium` : 'Glosarium';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">Glosarium</a>
      <Search />
      <nav>
        <a href="/">Tracks</a>
        <a href="/domains">Domains</a>
      </nav>
    </header>
    <div class="shell">
      <Sidebar />
      <main data-pagefind-body={indexed ? '' : undefined}>
        <slot />
      </main>
    </div>
  </body>
</html>
