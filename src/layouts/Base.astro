---
import '../styles/global.css';
import Search from '../components/Search.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  /** Include this page in the search index. Defaults to concept, topic and domain pages only. */
  indexed?: boolean;
}
const { title, description } = Astro.props;
// Track pages, the home page and the domain list each repeat ~2,000 concepts, so they stay out of search.
const path = Astro.url.pathname.replace(/\/$/, '');
const indexed = Astro.props.indexed ?? (/^\/(t|topics)\/[^/]+$/.test(path) || /^\/domains\/[^/]+$/.test(path));
const pageTitle = title ? `${title} · Glosarium` : 'Glosarium';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Apply a saved theme before first paint so the page doesn't flash the wrong colors.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">Glosarium</a>
      <Search />
      <nav>
        <a href="/">Tracks</a>
        <a href="/domains">Domains</a>
        <button type="button" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </nav>
    </header>
    <div class="shell">
      <Sidebar />
      <main data-pagefind-body={indexed ? '' : undefined}>
        <slot />
      </main>
    </div>
    <script>
      // Flip to the opposite of what's showing now (saved choice, else the OS setting) and remember it.
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
