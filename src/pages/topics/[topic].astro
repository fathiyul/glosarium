---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LevelSections from '../../components/LevelSections.astro';
import { loadGlossary, type Topic } from '../../lib/glossary';

export async function getStaticPaths() {
  const { topics } = await loadGlossary();
  return topics.map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}

const { topic } = Astro.props as { topic: Topic };
const { tracks, domainById, outline } = await loadGlossary();
const domain = domainById.get(topic.domain)!;
const topicTerms = outline.get(topic.id)!;
const { Content } = await render(topic);
---

<Base title={topic.data.title} description={topic.data.summary}>
  <p class="crumbs"><a href={`/domains/${domain.id}`}>{domain.data.title}</a></p>
  <h1>{topic.data.title}</h1>
  <p class="lede">{topic.data.summary}</p>
  <div class="prose"><Content /></div>
  {tracks.map((track) => {
    const inTrack = topicTerms.filter((t) => track.id in t.data.levels);
    return inTrack.length > 0 && (
      <section class="track-section" data-track={track.id}>
        <h2 id={track.id}><a href={`/tracks/${track.id}`}>{track.data.title}</a></h2>
        <LevelSections track={track} terms={inTrack} topics={[]} groupByTopic={false} nested />
      </section>
    );
  })}
</Base>
