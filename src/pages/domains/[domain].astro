---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { loadGlossary, type Domain } from '../../lib/glossary';

export async function getStaticPaths() {
  const { domains } = await loadGlossary();
  return domains.map((domain) => ({ params: { domain: domain.id }, props: { domain } }));
}

const { domain } = Astro.props as { domain: Domain };
const { topics, terms } = await loadGlossary();
const domainTopics = topics.filter((t) => t.domain === domain.id);
const { Content } = await render(domain);
---

<Base title={domain.data.title} description={domain.data.summary}>
  <p class="crumbs"><a href="/domains">Domains</a></p>
  <h1>{domain.data.title}</h1>
  <p class="lede">{domain.data.summary}</p>
  <div class="prose"><Content /></div>
  <h2>Topics</h2>
  <ul class="card-list">
    {domainTopics.map((t) => (
      <li>
        <a href={`/topics/${t.id}`}><strong>{t.data.title}</strong></a>
        <p>{t.data.summary}</p>
        <p>{terms.filter((term) => term.topic === t.id).length} concepts</p>
      </li>
    ))}
  </ul>
</Base>
