---
import { isCore, loadGlossary, type Track } from '../lib/glossary';
import LevelSections from './LevelSections.astro';

interface Props {
  track: Track;
}
const { track } = Astro.props;
const { terms, topics, tracks } = await loadGlossary();
const trackTerms = terms.filter((t) => track.id in t.data.levels);
---

{tracks.length > 1 && (
  <p class="meta">
    Track:
    {tracks.map((t) => (t.id === track.id ? <strong>{t.data.title}</strong> : <a href={`/tracks/${t.id}`}>{t.data.title}</a>))}
  </p>
)}
<h1>{track.data.title}</h1>
<p class="lede">{track.data.summary}</p>
<p class="meta">
  {trackTerms.length} concepts, {trackTerms.filter((t) => isCore(t, track)).length} of them core · jump to
  {track.data.levels.map((l) => <a href={`#${l.id}`}>{l.title}</a>)}
</p>
<LevelSections track={track} terms={trackTerms} topics={topics} />
